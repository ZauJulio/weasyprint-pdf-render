# Application
FLASK_ENV=development
LOG_LEVEL=INFO
MAX_HTML_SIZE_MB=10

# Server
HOST=0.0.0.0
PORT=5000

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=pdf-render
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# CORS
CORS_ORIGINS=*
CORS_MAX_AGE=600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_RENDER=20/minute

# Security
FORCE_HTTPS=false
